# AI Private Tutor — environment template
# Copy to .env and fill in real values. Never commit .env.

# ── LLM provider ─────────────────────────────────────────────────────
SUMOPOD_API_KEY=

# ── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
BOT_WEBHOOK_URL=https://senangbelajar.web.id/api/bot/webhook
ADMIN_TELEGRAM_ID=

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ai_private_tutor
PGPASSWORD=

# ── NextAuth ─────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://senangbelajar.web.id
AUTH_TRUST_HOST=true

# ── Admin dashboard login ────────────────────────────────────────────
# Password is stored as a bcrypt hash, never in plaintext and never in
# the source tree. Generate one with:
#
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
#
# IMPORTANT: dotenv performs variable expansion, so the `$2b$12$` prefix
# gets eaten unless each `$` is backslash-escaped. Quotes do NOT help.
# Write it exactly like this (note the backslashes):
#
#   ADMIN_PASSWORD_HASH=\$2b\$12\$abcdef...
#
# If either variable is unset, admin login is disabled entirely.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# ── Content sources ──────────────────────────────────────────────────
SIBI_EMAIL=
SIBI_PASSWORD=
TAVILY_API_KEY=
YOUTUBE_API_KEY=

# ── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Shared secret for /api/cron/* endpoints. Do NOT wrap in quotes: Next.js
# reads the value literally, so quotes become part of the token.
CRON_SECRET=
