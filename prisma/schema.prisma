generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GradeLevel {
  SD_5
  SMP_1
  SMA_2
}

enum StudentStatus {
  PENDING
  ACTIVE
  TRIAL
  PAUSED
  ARCHIVED
}

enum PersonaType {
  KAK_BUDI
  KAK_DEWI
  KAK_RAKA
}

enum MaterialStatus {
  DRAFT
  RAW
  PROCESSED
  VIDEO_READY
  READY
  ARCHIVED
}

enum DeliveryType {
  VIDEO
  TEXT
  TEXT_AND_VIDEO
}

enum AttemptType {
  QUIZ
  EXAM
}

enum SessionType {
  DAILY
  INTENSIVE
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  MISSED
  RESCHEDULED
}

enum InterventionSeverity {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum InterventionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum AgentType {
  CURRICULUM
  CONTENT
  MEDIA
  ASSESSMENT
  TUTOR
  GUARDIAN
  SCHEDULER
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
  RETRYING
}

model Student {
  id                  String        @id @default(uuid())
  studentId           String        @unique // login identifier e.g. "ANDI001"
  name                String
  telegramId          String?       @unique
  parentTelegramId    String?       // Telegram ID orang tua / wali
  gradeLevel          GradeLevel
  persona             PersonaType?  @default(KAK_BUDI)
  characterPreference String?       // "mbappe", "lisa", "kak-budi", etc
  interests           String?       // hobi & interests student
  scheduleConfig      Json?         // preferred schedule times
  passwordHash        String?       // bcrypt hash for student web login
  status              StudentStatus @default(ACTIVE)
  holdMode            String        @default("NONE") // "NONE" | "SOFT" | "HARD"
  isTemplate          Boolean       @default(false)

  // Gamification
  xp                  Int           @default(0)
  currentStreak       Int           @default(0)
  longestStreak       Int           @default(0)
  lastActivityDate    DateTime?     // date-only semantics, used for streak calc

  // Trial
  trialEndsAt         DateTime?     // set when status = TRIAL (7-day trial)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  curriculums    Curriculum[]
  quizzes        Quiz[]
  attempts       Attempt[]
  progressSnaps  ProgressSnap[]
  scheduleSessions ScheduleSession[]
  sessionStates  SessionState[]
  interventions  Intervention[]
  chatLogs       ChatLog[]
  apiUsages      ApiUsage[]
  reminders      Reminder[]
  homeworkTasks  HomeworkTask[]
  activityLogs   StudentActivity[]
  subjectMastery StudentSubjectMastery[]
  studySessions  StudySession[]
  badges         StudentBadge[]
  reviewQueue    ReviewQueue[]
  examAttempts   ExamAttempt[]
  improvementPlans ImprovementPlan[]
  topicMasteries TopicMastery[]
}

model CharacterImage {
  id        String   @id @default(uuid())
  name      String   // e.g. "Mbappe Action", "Lisa Full Body"
  theme     String   // "football", "kpop"
  fileName  String   // e.g. "football-mbappe-action-nobg.png"
  urlPath   String   // "/characters/football-mbappe-action-nobg.png"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}


model Curriculum {
  id            String        @id @default(uuid())
  studentId     String
  gradeLevel    GradeLevel
  version       Int           @default(1)
  changelog     String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  materials     Material[]

  @@unique([studentId, version])
}


model Material {
  id              String         @id @default(uuid())
  curriculumId    String
  topic           String
  subTopic        String?
  subject         String         // Matematika, Bahasa Indonesia, IPA, etc
  gradeLevel      GradeLevel
  weekOrder       Int            // week_1, week_2, etc
  priority        Int            @default(0)
  delivery        DeliveryType   @default(TEXT)
  status          MaterialStatus @default(DRAFT)
  prerequisiteId  String?
  sourceUrls      Json?          // array of source URLs
  rawContent      String?
  processedContent String?
  videoUrl        String?        // YouTube URL
  videoScript     String?
  characterUsed   String?        // which character was used for video
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  curriculum      Curriculum     @relation(fields: [curriculumId], references: [id])
  quizzes         Quiz[]
  prerequisites   Material[]     @relation("MaterialPrerequisites")
  prereqFor       Material[]     @relation("MaterialPrerequisites")
  activityLogs    StudentActivity[]

  @@index([curriculumId, subject, weekOrder])
}


model Quiz {
  id          String      @id @default(uuid())
  materialId  String
  studentId   String
  type        AttemptType @default(QUIZ)
  questions   Json        // array of question objects
  maxScore    Int
  timeLimit   Int?        // minutes, null = no limit
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  material    Material    @relation(fields: [materialId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attempts    Attempt[]
  reviewItems ReviewQueue[]

  @@index([materialId])
  @@index([studentId])
}

/// Gamification: badge catalogue. Seeded, not user-generated.
model Badge {
  id          String   @id @default(uuid())
  code        String   @unique // "first_quiz", "streak_7", "subject_master_matematika"
  name        String
  description String
  icon        String   // lucide icon name or emoji
  category    String   // "milestone" | "streak" | "mastery" | "consistency"
  xpReward    Int      @default(0)
  /// Threshold the rule engine compares against (meaning depends on category).
  threshold   Int?
  createdAt   DateTime @default(now())

  students    StudentBadge[]

  @@index([category])
}

/// Gamification: badge unlocked by a student. One row per (student, badge).
model StudentBadge {
  id         String   @id @default(uuid())
  studentId  String
  badgeId    String
  unlockedAt DateTime @default(now())

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeId])
  @@index([studentId, unlockedAt(sort: Desc)])
}

/// Spaced repetition queue (SM-2). One row per (student, quiz, questionIdx)
/// that the student answered incorrectly at least once.
model ReviewQueue {
  id           String   @id @default(uuid())
  studentId    String
  quizId       String
  questionIdx  Int
  subject      String
  topic        String?

  /// SM-2 state
  easeFactor   Float    @default(2.5)
  intervalDays Int      @default(1)
  repetitions  Int      @default(0)
  lapses       Int      @default(0)

  dueAt        DateTime
  lastReviewAt DateTime?
  mastered     Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([studentId, quizId, questionIdx])
  @@index([studentId, dueAt])
  @@index([studentId, mastered, dueAt])
}


model Attempt {
  id        String      @id @default(uuid())
  quizId    String
  studentId String
  type      AttemptType
  answers   Json        // [{questionIdx, answer, correct, score, timeSpent}]
  score     Int
  maxScore  Int
  masteryAfter Float?   // mastery level after this attempt
  timeSpent Int?        // seconds
  createdAt DateTime    @default(now())

  quiz      Quiz        @relation(fields: [quizId], references: [id])
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt(sort: Desc)])
}


model ProgressSnap {
  id          String   @id @default(uuid())
  studentId   String
  subject     String
  topic       String?
  mastery     Float    // 0.0 - 1.0
  quizCount   Int      @default(0)
  totalScore  Int      @default(0)
  totalMax    Int      @default(0)
  studyMinutes Int     @default(0)
  snapDate    DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, subject, snapDate])
}


model ScheduleSession {
  id          String        @id @default(uuid())
  studentId   String
  type        SessionType
  topic       String?
  subject     String?
  scheduledAt DateTime
  durationMin Int           @default(15)
  status      SessionStatus @default(SCHEDULED)
  completedAt DateTime?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, scheduledAt])
  @@index([status, scheduledAt])
}


model SessionState {
  id          String   @id @default(uuid())
  studentId   String   @unique
  currentMode String   @default("chat") // chat, quiz_active, vision_answer, choosing_topic, waiting_quiz_answer
  context     Json?    // {lastTopic, lastMaterialId, currentQuizId, currentQuestionIdx, answers[], lastPhotoFileId, lastIntent, adHoc, etc}
  updatedAt   DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}


model Persona {
  id          String      @id @default(uuid())
  type        PersonaType @unique
  name        String      // "Kak Budi", "Kak Dewi", "Kak Raka"
  greeting    String
  description String
  toneRules   Json        // linguistic rules for this persona
  forbiddenTopics Json?   // topics this persona cannot discuss
  createdAt   DateTime    @default(now())
}


model Intervention {
  id          String              @id @default(uuid())
  studentId   String
  issueType   String              // missed_sessions, low_score, mastery_stuck, behavior, emergency
  severity    InterventionSeverity @default(LOW)
  description String
  actions     Json?               // [{agent: "scheduler", action: "add_session", status: "done"}]
  status      InterventionStatus  @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
}


model ChatLog {
  id          String   @id @default(uuid())
  studentId   String
  role        String   // "user" or "assistant"
  content     String
  source      String?  // "telegram", "web"
  metadata    Json?
  createdAt   DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}


/// StudentActivity — real-time granular activity log
model StudentActivity {
  id          String   @id @default(uuid())
  studentId   String
  materialId  String?
  type        String   // "slide_view", "mindmap_view", "video_click", "quiz_start", "quiz_complete", "exam_start", "exam_complete"
  timeSpent   Int?     // seconds spent on this activity
  metadata    Json?    // {subject, topic, score?, maxScore?, progress?, source?, duration?}
  createdAt   DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  material    Material? @relation(fields: [materialId], references: [id])

  @@index([studentId, type, createdAt])
  @@index([studentId, createdAt])
}


/// StudySession — student login/logout or page focus sessions
model StudySession {
  id              String   @id @default(uuid())
  studentId       String
  startTime       DateTime @default(now())
  endTime         DateTime?
  durationMinutes Int?
  source          String   @default("web") // "web", "telegram"
  subject         String?
  topic           String?
  metadata        Json?
  createdAt       DateTime @default(now())

  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, startTime])
  @@index([studentId, startTime, endTime])
}


/// StudentSubjectMastery — per-subject achievement snapshot
model StudentSubjectMastery {
  id          String   @id @default(uuid())
  studentId   String
  subject     String

  // Quiz
  quizCount      Int   @default(0)
  quizTotalScore Int   @default(0)
  quizTotalMax   Int   @default(0)
  quizBestScore  Int   @default(0)
  quizBestMax    Int   @default(0)

  // Exam
  examCount      Int   @default(0)
  examTotalScore Int   @default(0)
  examTotalMax   Int   @default(0)
  examBestScore  Int   @default(0)
  examBestMax    Int   @default(0)

  // Activity counts
  slidesRead    Int   @default(0)
  mindmapsOpen  Int   @default(0)
  videosWatched Int   @default(0)

  // Computed
  mastery       Float @default(0.0) // 0.0 - 1.0 based on quiz+exam performance
  lastActiveAt  DateTime @default(now())

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subject])
  @@index([studentId])
}

model TopicMastery {
  id          String   @id @default(uuid())

  studentId   String
  subject     String
  topic       String
  subTopic    String?  // optional granular sub-topic

  // Quiz stats
  quizAttempts   Int @default(0)
  quizScoreSum   Int @default(0)
  quizScoreMax   Int @default(0)

  // Exam stats
  examAttempts   Int @default(0)
  examScoreSum   Int @default(0)
  examScoreMax   Int @default(0)

  // Computed scores (0-100)
  mastery         Float @default(0.0)  // Overall mastery %
  confidenceScore Float @default(0.0)  // Speed × accuracy index
  weaknessLevel   String @default("none") // "none" | "mild" | "moderate" | "severe"

  lastAttemptAt DateTime @default(now())
  streakDays    Int      @default(0)   // Consecutive days practiced
  streakUpdatedAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subject, topic, subTopic])
  @@index([studentId])
  @@index([studentId, subject])
  @@index([weaknessLevel])
}

model Reminder {
  id          String    @id @default(uuid())
  studentId   String
  title       String    // judul: "Ulangan Matematika", "Les Bahasa Inggris"
  description String?   // deskripsi opsional
  remindAt    DateTime  // kapan dikirim notifikasi
  category    String    @default("general") // "exam", "homework", "event", "study", "general"
  status      String    @default("pending") // "pending", "sent", "cancelled"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, remindAt, status])
  @@index([remindAt, status])
}


/// HomeworkTask — tugas PR dari sekolah dengan deadline
model HomeworkTask {
  id          String    @id @default(uuid())
  studentId   String
  subject     String    // "Matematika", "IPA", "Bahasa Indonesia"
  description String    // deskripsi PR
  deadlineAt  DateTime  // deadline
  status      String    @default("pending") // "pending", "submitted", "overdue", "cancelled"
  attachments Json?     // array of file URLs (foto PR)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, deadlineAt, status])
  @@index([studentId, status])
}


model ApiUsage {
  id               String   @id @default(uuid())
  studentId        String?
  agentType        String?  // "tutor", "guardian", "curriculum", etc
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  latencyMs        Int?     // response time in milliseconds
  costUsd          Float
  metadata         Json?
  createdAt        DateTime @default(now())

  student          Student? @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([createdAt])
}


model AgentLog {
  id        String    @id @default(uuid())
  agentType AgentType
  jobId     String?
  studentId String?
  action    String    // "generate_draft", "scrape", "render", "grade", etc
  status    JobStatus @default(QUEUED)
  input     Json?
  output    Json?
  error     String?
  traceId   String?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([agentType, status])
  @@index([createdAt])
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}


model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("parent") // parent, admin

  accounts Account[]
  sessions Session[]
}


model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


// NEW MODELS FOR EXAM SYSTEM

model Exam {
  id          String    @id @default(uuid())
  title       String    // e.g., "Post-test Modul Tata Surya" atau "Pre-test IPA SMP 1"
  type        String    // "PRE_TEST" | "POST_TEST"
  subject     String    // "IPA", "Matematika"
  gradeLevel  GradeLevel
  materialId  String?   // Jika POST_TEST, terikat ke material tertentu
  maxScore    Int       @default(100) // cached, computed as questions.length * 100
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions   ExamQuestion[]
  attempts    ExamAttempt[]

  @@index([gradeLevel, subject])
}

model ExamQuestion {
  id            String   @id @default(uuid())
  examId        String
  topic         String   // e.g., "Tata Surya" -> Untuk mapping kelemahan
  subTopic      String?
  question      String
  options       Json     // Array string
  correctAnswer String
  explanation   String
  difficulty    String   // "EASY" | "MEDIUM" | "HARD"
  createdAt     DateTime @default(now())

  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model ExamAttempt {
  id              String         @id @default(uuid())
  studentId       String
  examId          String
  score           Float
  maxScore        Float          @default(100)
  details         Json           // { answered: [...], timeSpentMs: [...], weaknesses: { "Rotasi Bumi": "HARD_FAILED" } }
  timeSpent       Int?           // total seconds spent on the exam
  status          String         // "IN_PROGRESS" | "COMPLETED" | "ANALYZED"
  createdAt       DateTime       @default(now())

  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam            Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  improvementPlan ImprovementPlan?

  @@index([studentId])
  @@index([examId])
}

model ImprovementPlan {
  id             String   @id @default(uuid())
  attemptId      String   @unique
  studentId      String
  aiNarrative    String   // Evaluasi deskriptif dari LLM
  recommendedSch Json     // Rekomendasi jadwal baru terstruktur
  status         String   // "DRAFT" | "APPLIED" (Bisa di-review dulu jika perlu)
  createdAt      DateTime @default(now())

  attempt        ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}
